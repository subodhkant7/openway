# ==============================================================================
# OpenWay Environment Configuration
# ==============================================================================
# NOTE: Never commit real credentials, tokens, or AWS keys to version control.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Ring Provider Selection
# ------------------------------------------------------------------------------
# Options:
#  - "simulator": Fully deterministic local mock provider (default for development/testing)
#  - "playground": Ring Developer Playground using short-lived access token
#  - "api": Production Ring Partner API provider
OPENWAY_PROVIDER=simulator

# Ring Developer Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Obtain a short-lived token from the Ring Developer Playground (https://developer.ring.com)
RING_ACCESS_TOKEN=

# Ring Partner API Base URL (defaults to official Amazon Vision API endpoint)
RING_API_BASE_URL=https://api.amazonvision.com

# Ring OAuth Base URL (official Ring OAuth host for token exchange)
RING_OAUTH_BASE_URL=https://oauth.ring.com

# Ring Webhook HMAC-SHA256 Signing Secret (configured in Ring Developer Portal)
RING_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Amazon Bedrock Multimodal Vision Analysis (AWS Builder Track)
# ------------------------------------------------------------------------------
# Vision Provider Selection:
#  - "simulator": Deterministic local simulation analyzer (default for offline dev & tests)
#  - "bedrock": Amazon Bedrock Runtime Converse API
OPENWAY_VISION_PROVIDER=simulator

# AWS Region where Bedrock multimodal foundation models are active
AWS_REGION=us-east-1

# Multimodal Vision Model Identifier:
# Recommended candidates: amazon.nova-lite-v1:0, anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional Amazon Bedrock Guardrail Configuration
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Bedrock Inference Timeout & Retry Settings
BEDROCK_TIMEOUT_MS=15000
BEDROCK_MAX_RETRIES=2

# Standard AWS Credentials (SERVER-SIDE ONLY)
# Read automatically from environment or AWS IAM role credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
